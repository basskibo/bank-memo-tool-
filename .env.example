# Copy this file to .env (same folder) and edit as needed.
# Never commit .env (see .gitignore) or share it in chat/PRs.

# LLM provider: "mlx" (Apple Silicon via mlx_lm.server), "ollama", or "api" (Anthropic).
POC_LLM_PROVIDER=ollama
# POC_LLM_PROVIDER=mlx
# POC_LLM_PROVIDER=api

# Extract: auto = one JSON-array call for mlx/api (~10× fewer document prefills).
# Set 0 to force the old one-field-per-call mode (better for tiny Ollama models).
# POC_EXTRACT_BATCH=auto
# POC_EXTRACT_BATCH=0

# --- when POC_LLM_PROVIDER=mlx ---
# Default: pipeline starts 14B or VL as needed and stops the other (POC_MLX_AUTOSWAP=1).
# First load takes ~15–40s. Override with POC_MLX_AUTOSWAP=0 and start both yourself:
#   .venv/bin/python -m mlx_lm server --model mlx-community/Qwen2.5-14B-Instruct-4bit --port 8080
#   .venv/bin/python -m mlx_vlm server --model mlx-community/Qwen2.5-VL-7B-Instruct-4bit --port 8081 --host 127.0.0.1
POC_MLX_AUTOSWAP=1
MLX_BASE_URL=http://127.0.0.1:8080
MLX_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit
# MLX_MODEL=mlx-community/Qwen2.5-14B-Instruct-4bit  # closer to Haiku; ~8 GB extra
MLX_VISION_BASE_URL=http://127.0.0.1:8081
MLX_VISION_MODEL=mlx-community/Qwen2.5-VL-7B-Instruct-4bit

# --- when POC_LLM_PROVIDER=ollama ---
OLLAMA_BASE_URL=http://mcs02.cmu:11434

# Text extract (Financial Wizard) when POC_OCR_ENGINE=tesseract AND POC_LLM_PROVIDER=ollama.
# When POC_OCR_ENGINE=vision and provider is ollama, extract reuses OLLAMA_VISION_MODEL.
OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_MODEL=qwen2.5:3b          # lighter default; weaker JSON on noisy OCR
# OLLAMA_MODEL=qwen2.5:7b          # better JSON, still local; ollama pull qwen2.5:7b
# OLLAMA_MODEL=qwen2.5:14b         # closest local stand-in for Haiku 4.5; ollama pull qwen2.5:14b
# OLLAMA_MODEL=mistral:7b          # better JSON than 3b; ollama pull mistral:7b
# OLLAMA_MODEL=llama3.1:8b         # solid extract; ollama pull llama3.1:8b
# OLLAMA_MODEL=gemma3:12b          # may already be pulled, but HEAVY next to any vision model — text-only

# --- when POC_LLM_PROVIDER=api ---
ANTHROPIC_API_KEY=sk-ant-...
POC_LLM_MODEL=claude-haiku-4-5-20251001
# API fallback if the local model cannot hold JSON; Haiku is enough for this POC.

# OCR for pages with no text layer (Document Ingestor, SPEC.md 3.1.1):
# "tesseract" (needs brew install tesseract tesseract-lang),
# "mlx_vision" (VL transcribes on MLX_VISION_BASE_URL, then 14B extracts — one model swap),
# "mlx_vision_extract" (FUSED: VL both transcribes AND extracts fields per page, no 14B swap,
#     Financial Wizard makes no LLM call — src/agents/vision_extractor.py),
# or "vision" (Ollama VL).
POC_OCR_ENGINE=mlx_vision
# POC_OCR_ENGINE=mlx_vision_extract
# POC_OCR_ENGINE=tesseract

# Vision OCR (Ollama). Used only when POC_OCR_ENGINE=vision.
# If POC_LLM_PROVIDER=ollama, Financial Wizard reuses this same resident VL model.
OLLAMA_VISION_MODEL=qwen2.5vl:3b
# OLLAMA_VISION_MODEL=qwen2.5vl:3b         # lighter; ollama pull qwen2.5vl:3b
# OLLAMA_VISION_MODEL=qwen2.5vl:7b         # better OCR (tables / Indic digits)
# OLLAMA_VISION_MODEL=granite3.2-vision:2b # lightest
# OLLAMA_VISION_MODEL=glm-ocr              # OCR-specialized, light
# OLLAMA_VISION_MODEL=qwen3-vl:8b          # heavier
# OLLAMA_VISION_MODEL=llama3.2-vision      # heavier; broken on some Ollama builds
# OLLAMA_VISION_MODEL=minicpm-v:8b         # heavier

# Optional: one keep_alive=0 after OCR (not recommended on Mini — causes Stopping...).
# OLLAMA_FORCE_VISION_UNLOAD=1
