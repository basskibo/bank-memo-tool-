# Kopiraj ovaj fajl u .env (u istom folderu) i podesi po potrebi.
# .env se NIKAD ne commit-uje (vidi .gitignore) i ne treba ga deliti u chatu/PR-u.

# Izaberi LLM provider: "ollama" (lokalni/mrežni Ollama server) ili "api" (Anthropic).
POC_LLM_PROVIDER=ollama

# --- ako je POC_LLM_PROVIDER=ollama ---
OLLAMA_BASE_URL=http://mcs02.cmu:11434
OLLAMA_MODEL=qwen2.5:3b
# Alternative modela (zavisi šta je povučeno na serveru): mistral:7b, llama3.1:8b

# --- ako je POC_LLM_PROVIDER=api ---
ANTHROPIC_API_KEY=sk-ant-...
POC_LLM_MODEL=claude-haiku-4-5-20251001

# OCR engine za skenirane/nečitljive stranice (Document Ingestor, SPEC.md 3.1.1):
# "tesseract" (default) ili "vision" (šalje stranicu vizuelnom LLM-u preko Ollama umesto
# klasičnom OCR-u — vidi evaluation/FINDINGS.md "Vision-LLM alternative" za zašto).
POC_OCR_ENGINE=tesseract
# Koristi se samo ako je POC_OCR_ENGINE=vision — mora biti povučen na Ollama serveru:
# ollama pull llama3.2-vision
OLLAMA_VISION_MODEL=llama3.2-vision
